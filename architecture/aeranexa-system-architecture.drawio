  <diagram id="aeranexa-system-architecture" name="AeraNexa 系统架构">
    <mxGraphModel dx="1940" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1940" pageHeight="1200" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;div style=&quot;font-size:28px;font-weight:700;color:#102a43&quot;&gt;AeraNexa 系统架构&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="45" y="24" width="900" height="48" as="geometry" />
        </mxCell>
        <mxCell id="3" value="&lt;div style=&quot;font-size:13px;color:#526575&quot;&gt;当前代码实现 · Next.js 16 / React 19 / TypeScript / MySQL · Web、后台任务与外部依赖&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="48" y="74" width="1000" height="28" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;div style=&quot;font-size:12px;color:#526575;text-align:right&quot;&gt;&lt;span style=&quot;color:#1565c0&quot;&gt;■&lt;/span&gt; 应用进程　&lt;span style=&quot;color:#2e7d32&quot;&gt;■&lt;/span&gt; 数据库　&lt;span style=&quot;color:#455a64&quot;&gt;■&lt;/span&gt; 外部系统　&lt;span style=&quot;color:#e65100&quot;&gt;┄&lt;/span&gt; 可选 / 尚未接入&lt;/div&gt;" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="1120" y="68" width="760" height="32" as="geometry" />
        </mxCell>
        <mxCell id="5" value="客户端与操作者" style="swimlane;startSize=42;horizontal=1;rounded=1;arcSize=10;fillColor=#f8fafc;swimlaneFillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontFamily=Arial;fontSize=16;fontStyle=1;whiteSpace=wrap;html=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="145" width="260" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="6" value="AeraNexa 运行时 · 独立进程" style="swimlane;startSize=42;horizontal=1;rounded=1;arcSize=10;fillColor=#f4f8fd;swimlaneFillColor=#f4f8fd;strokeColor=#90caf9;fontColor=#0d47a1;fontFamily=Arial;fontSize=16;fontStyle=1;whiteSpace=wrap;html=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="145" width="730" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="7" value="数据层与外部系统" style="swimlane;startSize=42;horizontal=1;rounded=1;arcSize=10;fillColor=#f7faf7;swimlaneFillColor=#f7faf7;strokeColor=#a5d6a7;fontColor=#1b5e20;fontFamily=Arial;fontSize=16;fontStyle=1;whiteSpace=wrap;html=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="1120" y="145" width="780" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;div style=&quot;font-size:16px;font-weight:700&quot;&gt;用户与管理员&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.5;margin-top:8px&quot;&gt;浏览器访问用户门户与管理后台&lt;br&gt;同源 HTTPS · HttpOnly 会话 Cookie&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#455a64;fontColor=#263238;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=12;" vertex="1" parent="5">
          <mxGeometry x="25" y="115" width="210" height="145" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;div style=&quot;font-size:16px;font-weight:700&quot;&gt;订阅客户端&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.5;margin-top:8px&quot;&gt;V2Ray / Clash / Mihomo 等&lt;br&gt;使用订阅 Token 拉取节点配置&lt;br&gt;可选设备 HWID 限制&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#455a64;fontColor=#263238;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=12;" vertex="1" parent="5">
          <mxGeometry x="25" y="420" width="210" height="160" as="geometry" />
        </mxCell>
        <mxCell id="10" value="&lt;div style=&quot;font-size:18px;font-weight:700;color:#0d47a1&quot;&gt;Web 应用&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#526575;margin-top:3px&quot;&gt;Next.js 16 · Node.js · pnpm start（启动前迁移）&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.5;margin-top:8px&quot;&gt;App Router：用户门户 + 管理后台&lt;br&gt;Route Handlers / Server Actions（BFF）&lt;br&gt;认证 / 会话 · 套餐 / 订单 / 钱包 / 邀请&lt;br&gt;工单 / 公告 / 文档 / 佣金 / 流量&lt;br&gt;订阅 API：Base64 / Clash，依据本地业务数据生成&lt;br&gt;支付：余额与 mock；真实外部网关尚未接入&lt;br&gt;可选 Clash 规则代理与 CF Server Monitor API relay&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontColor=#102a43;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=14;spacingTop=12;" vertex="1" parent="6">
          <mxGeometry x="30" y="90" width="670" height="350" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;div style=&quot;font-size:17px;font-weight:700;color:#0d47a1&quot;&gt;节点 Worker · 使用 3x-ui 时必需&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#526575;margin-top:3px&quot;&gt;独立常驻进程：pnpm worker&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.5;margin-top:7px&quot;&gt;Reconciler：脏数据约 5s；全量对账约 60s&lt;br&gt;Traffic Collector：约 60s　·　Inbound Importer：约 10min&lt;br&gt;MySQL 命名锁、失败退避与运行状态记录&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontColor=#102a43;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=14;spacingTop=10;" vertex="1" parent="6">
          <mxGeometry x="30" y="520" width="670" height="190" as="geometry" />
        </mxCell>
        <mxCell id="12" value="&lt;div style=&quot;font-size:16px;font-weight:700;color:#6a1b9a&quot;&gt;Telegram Bot · 可选进程&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#526575;margin-top:3px&quot;&gt;pnpm bot · 更新轮询与通知投递&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.45;margin-top:6px&quot;&gt;单实例锁避免重复消费；也可由 Web 接收 Telegram Webhook&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontColor=#311b44;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=14;spacingTop=10;" vertex="1" parent="6">
          <mxGeometry x="30" y="775" width="670" height="125" as="geometry" />
        </mxCell>
        <mxCell id="13" value="&lt;div style=&quot;font-size:18px;font-weight:700;color:#1b5e20&quot;&gt;MySQL · 业务数据源&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.5;margin-top:7px&quot;&gt;用户 / 会话 / 套餐 / 订单 / 钱包 / 支付账本&lt;br&gt;节点 / 权限组 / panel_clients 期望状态&lt;br&gt;流量游标与记录 / 系统设置 / 审计 / Worker 与 Bot 状态&lt;br&gt;敏感配置使用独立主密钥加密后入库&lt;/div&gt;" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b3a22;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=16;spacingTop=12;" vertex="1" parent="7">
          <mxGeometry x="20" y="80" width="740" height="165" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;div style=&quot;font-size:16px;font-weight:700&quot;&gt;SMTP 邮件服务&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.5;margin-top:7px&quot;&gt;注册验证码 · 密码重置&lt;br&gt;服务端发送，配置保存在后台&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#455a64;fontColor=#263238;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=10;" vertex="1" parent="7">
          <mxGeometry x="20" y="330" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="15" value="&lt;div style=&quot;font-size:17px;font-weight:700&quot;&gt;3x-ui 主控&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.5;margin-top:7px&quot;&gt;Worker 导入入站、同步客户端、采集流量&lt;br&gt;3x-ui 执行客户端状态；AeraNexa 保持业务权威&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#455a64;fontColor=#263238;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=10;" vertex="1" parent="7">
          <mxGeometry x="20" y="535" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="16" value="&lt;div style=&quot;font-size:17px;font-weight:700&quot;&gt;Xray 子节点&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.5;margin-top:7px&quot;&gt;由主控通过 mTLS 分发配置&lt;br&gt;承载客户端连接与流量统计&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#455a64;fontColor=#263238;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=10;" vertex="1" parent="7">
          <mxGeometry x="400" y="535" width="360" height="170" as="geometry" />
        </mxCell>
        <mxCell id="17" value="&lt;div style=&quot;font-size:16px;font-weight:700&quot;&gt;Telegram Bot API&lt;/div&gt;&lt;div style=&quot;font-size:12px;line-height:1.5;margin-top:7px&quot;&gt;Bot 轮询 / 发送消息&lt;br&gt;Webhook 模式可直接进入 Web API&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#455a64;fontColor=#263238;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=10;" vertex="1" parent="7">
          <mxGeometry x="20" y="760" width="740" height="125" as="geometry" />
        </mxCell>
        <mxCell id="18" value="&lt;div style=&quot;font-size:15px;font-weight:700;color:#e65100&quot;&gt;真实支付网关适配 · 尚未接入&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#6d4c41;margin-top:5px&quot;&gt;当前用户结账仅有余额与 mock；通用回调处理骨架不代表已接通渠道。&lt;/div&gt;" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontColor=#5d4037;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;spacingTop=8;" vertex="1" parent="7">
