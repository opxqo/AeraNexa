{
  "name": "aeranexa-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import ./scripts/ts-register.mjs scripts/web-server.mjs",
    "build": "next build",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-database.mjs",
    "db:create-admin": "node --env-file-if-exists=.env.local scripts/create-admin.mjs",
    "backup:export": "node --env-file-if-exists=.env.local --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/backup.mjs export",
    "backup:restore": "node --env-file-if-exists=.env.local --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/backup.mjs restore",
    "start": "node --env-file-if-exists=.env.local scripts/migrate-database.mjs && NODE_ENV=production node --env-file-if-exists=.env.local --import ./scripts/ts-register.mjs scripts/web-server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:user": "node --env-file=.env.local --test tests/user-system/*.test.mjs",
    "test:acceptance": "node --env-file=.env.local --test tests/acceptance/*.test.mjs",
    "test": "node --env-file=.env.local --import ./scripts/ts-register.mjs --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-concurrency=1 tests/schema/*.test.mjs tests/node-domain/*.test.mjs tests/payments/*.test.mjs tests/user-system/*.test.mjs tests/acceptance/*.test.mjs tests/logs/*.test.mjs tests/backup/*.test.mjs",
    "test:schema": "node --test tests/schema/*.test.mjs",
    "worker": "node --env-file-if-exists=.env.local --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/node-worker.mjs",
    "bot": "node --env-file-if-exists=.env.local --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/bot-worker.mjs",
    "test:node": "node --import ./scripts/ts-register.mjs --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/node-domain/*.test.mjs"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.341",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.4",
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "typescript": "6.0.3"
  }
}
