# The future airport backend facade. Do not expose 3x-ui admin credentials here.
BACKEND_API_URL=http://localhost:8080/api

# Temporary compatibility target used only while V2Board business modules remain in place.
V2BOARD_API_URL=http://localhost:8000/api/v1

# AeraNexa user system (server-only variables; never prefix with NEXT_PUBLIC_).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aeranexa
DB_USER=root
DB_PASSWORD=replace-with-local-mysql-password
AUTH_SESSION_SECRET=replace-with-a-random-32-byte-secret
EMAIL_VERIFICATION_CODE=666666
SUBSCRIBE_BASE_URL=http://localhost:3000
