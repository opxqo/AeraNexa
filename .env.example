# 这里只放「必须留在服务器环境」的配置：数据库连接、会话密钥、加密主密钥与哈希 pepper。
# 3x-ui 连接、订阅域名、佣金、Worker 调度等运行时配置在后台「系统设置」中调整
#（未设置时仍会回退读取同名环境变量，见文末）。所有变量只在服务端使用，不要加 NEXT_PUBLIC_ 前缀。

# 数据库（系统设置本身存在数据库里，连接信息只能放环境变量）
# DB_NAME 可以填任意已存在或希望新建的库名，不强制叫 aeranexa
# （例如托管平台自带的默认库）；pnpm db:migrate 会按这个值建库建表。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aeranexa
DB_USER=root
DB_PASSWORD=replace-with-local-mysql-password
# DB_CONNECTION_LIMIT=5

# 会话签名密钥：登录拦截在不能查库的运行时校验，且放进数据库会让库泄露即可伪造管理员会话
AUTH_SESSION_SECRET=replace-with-a-random-32-byte-secret

# 加密主密钥（Base64 编码的随机 32 字节，可用 `openssl rand -base64 32` 生成）。
# 它们加密的密文存在数据库里，主密钥必须与数据库分开保存；更换后已保存的密文将无法解开。
SMTP_CONFIG_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
PAYMENT_CONFIG_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# 系统设置中的敏感项（3x-ui API Token、节点上报密钥）
SETTINGS_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# 哈希 pepper：数据库只存验证码 / 卡密的哈希，pepper 必须与数据库分开；更换后已发放的卡密全部失效
EMAIL_VERIFICATION_PEPPER=replace-with-a-long-random-secret
RECHARGE_CARD_SECRET=replace-with-a-long-random-secret
TELEGRAM_BINDING_PEPPER=replace-with-a-long-random-secret

# 仅本地 mock 签名回调沙箱使用；生产环境须为真实渠道在后台保存加密回调密钥。
PAYMENT_SANDBOX_WEBHOOK_SECRET=replace-with-a-long-random-secret

# 易支付（彩虹易支付 EPay 协议）网关与商户号，优先使用后台「系统设置 → 支付」的值，这里只是回退；
# 商户密钥在后台支付渠道的「回调签名密钥」里加密保存。
# 后台渠道标识填 epay_wxpay / epay_alipay，「回调域名」填本站对外地址（渠道要能访问到）。
# EPAY_GATEWAY_URL=https://normal.33zn.com
# EPAY_PID=1000

# ---------------------------------------------------------------------------
# 以下均可在后台「系统设置」中修改；后台已保存的值优先，这里只作为兼容旧部署的回退。
# PANEL_BASE_URL=http://localhost:2053/
# PANEL_API_TOKEN=
# PANEL_TIMEOUT_MS=10000
# NODE_TRAFFIC_SECRET=
# CF-Server-Monitor 监控对接：地址必填才有意义；auth_mode=auto 时公开仪表盘免密钥、
# 非公开自动用账号密码登录换 JWT；对方非公开时填 CFSM_USERNAME / CFSM_PASSWORD。
# CFSM_BASE_URL=
# CFSM_AUTH_MODE=auto
# CFSM_USERNAME=
# CFSM_PASSWORD=
# CFSM_TIMEOUT_MS=8000
# SUBSCRIBE_BASE_URL=http://localhost:3000
# SUBSCRIBE_CLASH_PROVIDER=aeranexa
# 选择 3x-ui 规则来源时，填写 3x-ui「订阅 → Clash URI」的完整前缀；留空才尝试 /mihomo/。
# PANEL_CLASH_SUBSCRIBE_URL=
# COMMISSION_RATE_PERCENT=0
# COMMISSION_AVAILABLE_AFTER_DAYS=0
# WORKER_EVENT_INTERVAL_MS=5000
# WORKER_TRAFFIC_INTERVAL_MS=60000
# WORKER_RECONCILE_INTERVAL_MS=60000
# WORKER_IMPORT_INTERVAL_MS=600000
# TELEGRAM_BOT_ENABLED=false
# TELEGRAM_BOT_MODE=polling
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_URL=
# TELEGRAM_WEBHOOK_SECRET=
